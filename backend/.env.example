# UDM Alumni Tracer API — copy to .env for local development. Never commit real values.
# config/ validates these at startup and exits with a clear error if anything is missing or unsafe.

NODE_ENV=development            # production: turns off the console mailer and the demo seed
PORT=4000                       # set by the host in production
LOG_LEVEL=info

# Postgres 16. Production must use sslmode=require. With a pooler (e.g. Neon), use the pooled URL here and the
# direct URL for migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/udm_alumni
# DATABASE_URL_DIRECT=postgres://...?sslmode=require

SESSION_TTL_DAYS=14
SESSION_IDLE_HOURS=12

APP_URL=http://localhost:5173   # public frontend URL used in email links (https://<vercel-domain> in production)
# CORS_ORIGIN=                  # only if the API is ever called cross-origin; production uses the same-origin Vercel rewrite
TRUST_PROXY=true                # read the client IP from X-Forwarded-For (behind Vercel + the host proxy)

# Mail: console (dev only, prints links/codes) | google (Gmail API, production) | smtp (fallback) | memory (tests)
MAIL_DRIVER=console
MAIL_FROM="UDM Alumni <no-reply@udmalumni.edu>"
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # whole JSON in one variable (secret)
# GOOGLE_IMPERSONATE_USER=no-reply@udmalumni.edu
# SMTP_URL=smtps://no-reply%40udmalumni.edu:<app-password>@smtp.gmail.com:465

# Files: local (development) | s3 (production; any S3-compatible bucket, e.g. Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=udm-alumni
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# FILE_SIGNING_SECRET=          # signs private file URLs with the local driver (defaults to CRON_SECRET)

CRON_SECRET=change-me-to-a-long-random-string   # protects POST /api/v1/internal/jobs/:name

# Optional tuning
# AUTH_RATE_LIMIT_MAX=30
# AUTH_RATE_LIMIT_WINDOW_MIN=15
# OUTREACH_RATE_LIMIT_MAX=60
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_MINUTES=15

# Tests use an embedded Postgres by default; set this to run them against a Postgres 16 server instead (CI).
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
