# UDM Alumni Tracer API. Copy to .env for local development; production values live in the host's settings
# (see docs/deploy-notes.md). Required variables are checked at boot.

APP_NAME="UDM Alumni Tracer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public frontend URL, used in email links.
APP_URL=http://localhost:5173
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local Postgres 16 on 5433 (or a Neon dev branch via DB_URL). In production DB_URL is the pooled URL and
# DB_URL_DIRECT the direct one used for migrations (php artisan migrate --database=pgsql_direct), both with sslmode=require.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=udm_alumni
DB_USERNAME=postgres
DB_PASSWORD=
# DB_URL=
# DB_URL_DIRECT=

HASH_DRIVER=argon2id

# Built-in admin, created on container start (php artisan app:ensure-admin) if missing. ADMIN_PASSWORD is required
# until the account exists; it must be changed at first sign-in and is never applied to an existing account.
# ADMIN_EMAIL=admin@udmalumni.edu
# ADMIN_PASSWORD=

SESSION_TTL_DAYS=14
SESSION_IDLE_HOURS=12
# The udm_sid cookie is Secure everywhere except APP_ENV=local/testing; override only if you must.
# SESSION_SECURE_COOKIE=
# Requests per minute per IP on /auth/* (throttle:auth).
# AUTH_RATE_LIMIT=10

# Rate limiter storage. The API has no Laravel session or queue.
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# log | gmail | smtp. "log" writes each email to storage/logs and is refused when APP_ENV=production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=udm.alumni.mailer@gmail.com
MAIL_FROM_NAME="UDM Alumni Relations"
# EMAIL_TEMPLATES_PATH=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# Later, instead of OAuth: a Workspace service account (JSON, or a path to the file) with domain-wide delegation.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_IMPERSONATE_USER=no-reply@udmalumni.edu

FILESYSTEM_DISK=local
# AWS_ENDPOINT=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Protects POST /api/v1/internal/jobs/:name (24+ characters in production).
CRON_SECRET=local-cron-secret-change-me

# Whether self-registered alumni wait for admin approval before they can sign in (default: off in production, on elsewhere).
# REGISTRATION_REQUIRES_APPROVAL=true

# Set to true only to run the DemoSeeder against a non-local (staging) database.
ALLOW_DEMO_SEED=false
