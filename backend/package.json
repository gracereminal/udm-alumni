{
  "name": "udm-alumni-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:local": "node scripts/local-db.js",
    "migrate": "node-pg-migrate -m migrations --envPath .env",
    "seed:lookups": "node seed/lookups.js",
    "seed:demo": "node seed/demo.js",
    "create-user": "node scripts/create-user.js",
    "mail:test": "node scripts/mail-test.js",
    "google:token": "node scripts/google-oauth-token.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.1.1",
    "google-auth-library": "^11.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "embedded-postgres": "^16.14.0-beta.17",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
